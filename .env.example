# --- Backend (set these in Vercel Project Settings > Environment Variables) ---
MONGODB_URI=your-mongodb-atlas-connection-string
JWT_SECRET=a-long-random-string
WHATSAPP_NUMBER=919645213232
NODE_ENV=production
# Local only: the API defaults to 5001 because macOS can reserve port 5000.
# PORT=5001

# The API runs on http://localhost:5001 and Vite proxies /api requests to it.
# MONGODB_URI is required: without it, product and category data is not stored.
